{
  "type": "record",
  "name": "VisaTokenised",
  "namespace": "com.fraud_detection.tokenised",
  "doc": "Tokenised Visa ISO 8583 transaction. PAN replaced with format-preserving token via HMAC-SHA256.",
  "fields": [
    {"name": "transaction_id", "type": "string", "doc": "Unique transaction identifier."},
    {"name": "source", "type": "string", "default": "VISA", "doc": "Payment source identifier."},
    {"name": "message_type", "type": ["null", "string"], "default": null, "doc": "ISO 8583 message type e.g. 0100, 0200."},
    {"name": "timestamp", "type": "string", "doc": "ISO-8601 processing timestamp."},
    {"name": "event_time_ms", "type": "long", "doc": "Unix epoch milliseconds of original event."},
    {"name": "tokenisation_timestamp", "type": "string", "doc": "ISO-8601 timestamp of tokenisation."},
    {"name": "card_token", "type": "string", "doc": "Format-preserving PAN token. Preserves BIN (first 6) and last 4. Same length and digit-only format as original PAN."},
    {"name": "bin", "type": ["null", "string"], "default": null, "doc": "Bank Identification Number (first 6 digits). Retained for fraud feature engineering."},
    {"name": "last4", "type": ["null", "string"], "default": null, "doc": "Last 4 digits of card."},
    {"name": "token_from_cache", "type": "boolean", "default": false, "doc": "True if token was served from in-memory cache."},
    {"name": "tokenisation_method", "type": "string", "default": "FORMAT_PRESERVING_HMAC", "doc": "Algorithm used for tokenisation."},
    {"name": "amount", "type": ["null", "double"], "default": null, "doc": "Transaction amount."},
    {"name": "currency_code", "type": ["null", "string"], "default": null, "doc": "ISO 4217 numeric currency code."},
    {"name": "currency", "type": ["null", "string"], "default": null, "doc": "ISO 4217 alphabetic currency code e.g. KES, USD."},
    {"name": "merchant_id", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE042 Merchant ID."},
    {"name": "merchant_name", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE043 Merchant Name."},
    {"name": "terminal_id", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE041 Terminal ID."},
    {"name": "mcc", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE018 Merchant Category Code."},
    {"name": "transaction_type", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE003 Processing Code."},
    {"name": "pos_entry_mode", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE022 POS Entry Mode."},
    {"name": "stan", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE011 System Trace Audit Number."},
    {"name": "acquirer_id", "type": ["null", "string"], "default": null, "doc": "ISO 8583 DE032 Acquiring Institution ID."}
  ]
}
