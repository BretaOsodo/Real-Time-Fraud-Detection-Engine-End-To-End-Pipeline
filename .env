AIRFLOW_UID=50000
VAULT_URL="http://localhost:8200"
VAULT_TOKEN="dev-token"
export KAFKA_BOOTSTRAP_SERVERS=localhost:29092
export REDIS_HOST=localhost
export SPARK_CHECKPOINT_DIR=/tmp/checkpoints
export SCHEMA_DIR=./schema
# ==========================================================
# Kafka Configuration
# ==========================================================
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:19092,kafka-broker-2:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN

# ==========================================================
# Spark Streaming Configuration
# ==========================================================
SPARK_CHECKPOINT_DIR=/checkpoints
SCHEMA_DIR=/schema

MAX_OFFSETS_PER_TRIGGER=50000
TRIGGER_INTERVAL=1 second
WATERMARK_DELAY=60 seconds
STARTING_OFFSETS=earliest

# ==========================================================
# Enrichment Configuration
# ==========================================================
HIGH_VALUE_THRESHOLD_USD=2000.0
ENRICHMENT_BUDGET_MS=50

# ==========================================================
# Redis Configuration
# ==========================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Kidathegreat
REDIS_SSL=false

# ==========================================================
# Metrics / Monitoring
# ==========================================================
METRICS_PORT=8000